{
  "name": "hocuspocus-extension-valkey",
  "version": "2.0.0",
  "description": "Scale Hocuspocus horizontally with Valkey",
  "homepage": "https://github.com/scraiber/hocuspocus-extension-valkey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scraiber/hocuspocus-extension-valkey.git"
  },
  "keywords": [
    "hocuspocus",
    "scraiber",
    "valkey",
    "yjs"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/hocuspocus-redis.cjs",
  "module": "dist/hocuspocus-redis.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    "source": {
      "import": "./src/index.ts"
    },
    "default": {
      "import": "./dist/hocuspocus-redis.esm.js",
      "require": "./dist/hocuspocus-redis.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "@hocuspocus/common": "^4.3.0",
    "@hocuspocus/server": "^4.3.0",
    "@sesamecare-oss/redlock": "^1.4.0",
    "iovalkey": "^0.3.3",
    "kleur": "^4.1.4"
  },
  "peerDependencies": {
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.8"
  }
}
